GEMINI_API_KEY=
SARVAM_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_REWRITE_MODEL=google/gemini-2.5-flash

# PostgreSQL Database (Neon) — REQUIRED
# Get your connection string from Neon console: https://console.neon.tech
# Format: postgresql://user:password@host/database
DATABASE_URL=

# Clerk — REQUIRED for authenticated endpoints.
# Either the publishable key (JWKS URL is derived from it) or the JWKS URL directly.
CLERK_PUBLISHABLE_KEY=
# CLERK_JWKS_URL=https://<your-app>.clerk.accounts.dev/.well-known/jwks.json
# Optional: comma-separated origins allowed in the token's azp claim
# CLERK_AUTHORIZED_PARTIES=http://localhost:5173

# CORS — comma-separated browser origins. Defaults to local dev origins if unset.
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Email (server-side credentials; clients can no longer supply their own)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SENDER_EMAIL=
# SENDGRID_API_KEY=
